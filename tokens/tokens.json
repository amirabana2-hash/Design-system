{
  "$description": "Design tokens exported from the Simple Design System Figma library (foundations page). W3C Design Token Community Group format.",
  "color": {
    "background": {
      "default": {
        "default": { "$value": "#ffffff", "$type": "color" },
        "secondary": { "$value": "#f5f5f5", "$type": "color" }
      },
      "warning": {
        "secondary": { "$value": "#fff1c2", "$type": "color" },
        "tertiary": { "$value": "#fffbeb", "$type": "color" }
      }
    },
    "text": {
      "default": {
        "default": { "$value": "#1e1e1e", "$type": "color" }
      },
      "warning": {
        "on-warning-secondary": { "$value": "#682d03", "$type": "color" },
        "on-warning-tertiary": { "$value": "#522504", "$type": "color" }
      }
    },
    "border": {
      "default": {
        "default": { "$value": "#d9d9d9", "$type": "color" }
      },
      "warning": {
        "default": { "$value": "#522504", "$type": "color" },
        "tertiary": { "$value": "#bf6a02", "$type": "color" }
      }
    },
    "icon": {
      "warning": {
        "on-warning-secondary": { "$value": "#682d03", "$type": "color" }
      }
    },
    "black": {
      "100": { "$value": "#0c0c0d0d", "$type": "color" },
      "200": { "$value": "#0c0c0d1a", "$type": "color" }
    }
  },
  "size": {
    "space": {
      "200": { "$value": "8px", "$type": "dimension" },
      "300": { "$value": "12px", "$type": "dimension" },
      "400": { "$value": "16px", "$type": "dimension" },
      "800": { "$value": "32px", "$type": "dimension" },
      "1600": { "$value": "64px", "$type": "dimension" }
    },
    "padding": {
      "xl": { "$value": "24px", "$type": "dimension" }
    },
    "radius": {
      "200": { "$value": "8px", "$type": "dimension" },
      "400": { "$value": "16px", "$type": "dimension" },
      "xl": { "$value": "24px", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "stroke": {
      "border": { "$value": "1px", "$type": "dimension" }
    },
    "icon": {
      "small": { "$value": "24px", "$type": "dimension" }
    },
    "depth": {
      "0": { "$value": "0px", "$type": "dimension" },
      "100": { "$value": "4px", "$type": "dimension" },
      "negative-025": { "$value": "-1px", "$type": "dimension" }
    }
  },
  "typography": {
    "family": {
      "default": { "$value": "Inter", "$type": "fontFamily" },
      "mono": { "$value": "Roboto Mono", "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "scale": {
      "03": { "$value": "16px", "$type": "dimension" }
    },
    "title-hero": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "72px",
        "fontWeight": "{typography.weight.bold}",
        "lineHeight": 1.2,
        "letterSpacing": "-3%"
      },
      "$type": "typography"
    },
    "title-page": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "48px",
        "fontWeight": "{typography.weight.bold}",
        "lineHeight": 1.2,
        "letterSpacing": "-2%"
      },
      "$type": "typography"
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "32px",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.2,
        "letterSpacing": "0%"
      },
      "$type": "typography"
    },
    "heading": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "24px",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": 1.2,
        "letterSpacing": "-2%"
      },
      "$type": "typography"
    },
    "subheading": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "20px",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.2,
        "letterSpacing": "0%"
      },
      "$type": "typography"
    },
    "body-base": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "16px",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.4,
        "letterSpacing": "0%"
      },
      "$type": "typography"
    },
    "body-strong": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "16px",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": 1.4,
        "letterSpacing": "0%"
      },
      "$type": "typography"
    },
    "body-emphasis": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "16px",
        "fontWeight": "{typography.weight.regular}",
        "fontStyle": "italic",
        "lineHeight": 1.4,
        "letterSpacing": "0%"
      },
      "$type": "typography"
    },
    "body-small": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "14px",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.4,
        "letterSpacing": "0%"
      },
      "$type": "typography"
    },
    "body-small-strong": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "14px",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": 1.4,
        "letterSpacing": "0%"
      },
      "$type": "typography"
    },
    "body-code": {
      "$value": {
        "fontFamily": "{typography.family.mono}",
        "fontSize": "16px",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1.3,
        "letterSpacing": "0%"
      },
      "$type": "typography"
    },
    "single-line-body-base": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "16px",
        "fontWeight": "{typography.weight.regular}",
        "lineHeight": 1,
        "letterSpacing": "0%"
      },
      "$type": "typography"
    },
    "single-line-body-small-strong": {
      "$value": {
        "fontFamily": "{typography.family.default}",
        "fontSize": "14px",
        "fontWeight": "{typography.weight.semibold}",
        "lineHeight": 1,
        "letterSpacing": "0%"
      },
      "$type": "typography"
    }
  },
  "shadow": {
    "drop-300": {
      "$value": [
        {
          "color": "{color.black.100}",
          "offsetX": "{size.depth.0}",
          "offsetY": "{size.depth.100}",
          "blur": "{size.depth.100}",
          "spread": "{size.depth.negative-025}"
        },
        {
          "color": "{color.black.200}",
          "offsetX": "{size.depth.0}",
          "offsetY": "{size.depth.100}",
          "blur": "{size.depth.100}",
          "spread": "{size.depth.negative-025}"
        }
      ],
      "$type": "shadow"
    }
  }
}
